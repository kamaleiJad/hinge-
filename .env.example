# Which LLM backend to use: "anthropic" or "ollama"
LLM_PROVIDER=anthropic

# --- Anthropic backend ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Ollama backend (local, offline) ---
# Defaults shown. Run a model like `ollama pull qwen2.5` first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# Port the Express proxy listens on (Vite dev server proxies /api here).
PORT=8787
